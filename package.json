{
  "name": "wamda-social",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node tests/social/media-core.mjs && node tests/social/cloudinary-local.mjs && firebase emulators:exec --only auth,firestore --project demo-wamda \"node tests/social/browser.mjs && node tests/social/media-http.mjs && node tests/social/rules.mjs\"",
    "test:visual": "node tests/social/browser.mjs",
    "preview": "node scripts/serve.mjs",
    "media:local": "node media/serve.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-wamda"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/router": "22.3.0",
    "firebase": "^13.4.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@axe-core/playwright": "4.11.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.0.0",
    "firebase-tools": "^15.37.0",
    "playwright": "1.56.1",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
